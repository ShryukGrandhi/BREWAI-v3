# ===========================================
# BREWAI v4 Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=4000
API_VERSION=v1

# ===========================================
# MongoDB Configuration
# ===========================================
MONGO_URI=mongodb://mongo:27017/brewai
MONGO_DB_NAME=brewai

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ===========================================
# JWT Authentication
# ===========================================
# Generate a secure secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# MinIO / S3 Object Storage
# ===========================================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_SESSIONS=session-replays
MINIO_BUCKET_DOCS=documents
MINIO_USE_SSL=false

# ===========================================
# OpenRouter LLM Configuration
# ===========================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default models for different tasks
OPENROUTER_MODEL_CHAT=anthropic/claude-3-haiku
OPENROUTER_MODEL_SUMMARY=anthropic/claude-3-haiku
OPENROUTER_MODEL_CONTENT=anthropic/claude-3-sonnet

# ===========================================
# Firecrawl Configuration
# ===========================================
# Get your API key from: https://firecrawl.dev
FIRECRAWL_API_KEY=your-firecrawl-api-key
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v0
FIRECRAWL_SIMULATE=true

# ===========================================
# Reducto Configuration
# ===========================================
# Get your API key from: https://reducto.ai
REDUCTO_API_KEY=your-reducto-api-key
REDUCTO_BASE_URL=https://api.reducto.ai/v1
REDUCTO_SIMULATE=true

# ===========================================
# Session Replay Configuration
# ===========================================
SESSION_SAMPLE_RATE=0.2
SESSION_CHUNK_INTERVAL_MS=10000
SESSION_MAX_EVENTS_PER_CHUNK=10000

# ===========================================
# Observability (Optional)
# ===========================================
SENTRY_DSN=
LOG_LEVEL=debug
LOG_FORMAT=json

# ===========================================
# Agent Configuration
# ===========================================
AGENT_BACKEND_URL=http://backend:4000/api/v1
AGENT_POLL_INTERVAL_MS=30000

# ===========================================
# Frontend Configuration
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SESSION_TRACKING_ENABLED=true
NEXT_PUBLIC_SESSION_SAMPLE_RATE=1.0
